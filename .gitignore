# Project place files (keep code in src/, places built with Rojo)
*.rbxlx
*.rbxl
*.rbxlx.lock
*.rbxl.lock

# Rojo sourcemap
sourcemap.json
.rojo/

# MCP / local auth
.robloxstudio-mcp/

# OS and temporary files
Thumbs.db
Desktop.ini
.DS_Store
*.tmp

# Roblox type definitions (downloaded by scripts/check.sh)
.luau-types/
# Graphify per-query stamp (changes on every query)
graphify-out/cache/last_query_stamp

# Graphify local outputs (regenerated by scripts/graph_update.py; graph.json is the committed artifact)
graphify-out/graph.html
graphify-out/GRAPH_REPORT.md
graphify-out/.graphify_build_state.json
graphify-out/.graphify_labels*.json
graphify-out/.graphify_labels*.sig

# Card art: only the cropped PNGs are committed; source sheets and the preview stay local
Artwork assets/Cards/*.jpg
Artwork assets/Cards/cropped/_preview.png
