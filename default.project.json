        "$properties": {
          "Intensity": 0.35,
          "Size": 18,
          "Threshold": 2.6
        }
      },
      "Warmth": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.02,
          "Contrast": 0.08,
          "Saturation": -0.05,
          "TintColor": [
            1.0,
